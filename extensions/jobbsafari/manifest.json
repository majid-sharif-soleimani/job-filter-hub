{
  "manifest_version": 3,
  "name": "Jobbsafari Job Filter (AI)",
  "version": "1.0.0",
  "description": "Reads each job ad on a jobbsafari.se list page, scores it against your resume with AI, and hides the ones that don't fit.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Filter job ads on this page (click again to stop)",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://jobbsafari.se/*",
    "https://www.jobbsafari.se/*",
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.typesafe.ai/*",
    "https://openrouter.ai/*",
    "https://ai-gateway.vercel.sh/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://jobbsafari.se/*",
        "https://www.jobbsafari.se/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
