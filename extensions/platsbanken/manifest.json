{
  "manifest_version": 3,
  "name": "Platsbanken Job Filter (AI)",
  "version": "1.1.0",
  "description": "Opens each ad on an Arbetsförmedlingen Platsbanken results page (Platsbanken and Externa webbplatser tabs) in the background, scores it against your resume with AI, and marks the ones that don't fit.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Filter ads on this page (click again to stop)",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://arbetsformedlingen.se/*",
    "https://www.arbetsformedlingen.se/*",
    "https://platsbanken-api.arbetsformedlingen.se/*",
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.typesafe.ai/*",
    "https://openrouter.ai/*",
    "https://ai-gateway.vercel.sh/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://arbetsformedlingen.se/platsbanken/*",
        "https://www.arbetsformedlingen.se/platsbanken/*"
      ],
      "js": [
        "extract.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
